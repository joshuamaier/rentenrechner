{
  "name": "rentenrechner",
  "version": "1.2.0",
  "private": true,
  "description": "Rentenrechner mit Anspar- und Auszahlphase, Rückwärtsrechnung, Grafik und Jahrestabelle",
  "author": "Joshua Maier (https://joshuamaier.de)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshuamaier/rentenrechner.git"
  },
  "homepage": "https://joshuamaier.de/blog/rentenrechner.html",
  "keywords": [
    "rentenrechner",
    "altersvorsorge",
    "sparplan",
    "entnahmeplan",
    "finanzmathematik"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "npx http-server -c-1 -p 8080 .",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . && html-validate index.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "html-validate": "11.16.1",
    "prettier": "3.9.9"
  }
}
